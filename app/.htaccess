Options +FollowSymLinks

Redirect 301 /index.php /w/index.php

# Enable rewrite engine
RewriteEngine on

# Handle direct file and directory access first - no rewriting needed
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Handle health checks
RewriteCond %{HTTP_USER_AGENT} ^ELB-HealthChecker/2\.0$ [NC]
RewriteRule ^ /w/index.php [L]

# Handle index.php redirect
RewriteRule ^index\.php$ /w/index.php [R=301,L]

# Hotlinking blacklist - haleyjd 20170827
RewriteCond %{HTTP_REFERER} ^https?://(m\.)?joemonster\.org/.*$ [NC]
RewriteRule \.(gif|jpe?g|png)$ - [F]

# Commercial scraping blacklist - haleyjd 20171007
RewriteCond %{HTTP_USER_AGENT} atraxbot [NC,OR]
RewriteCond %{HTTP_USER_AGENT} Azureus [NC,OR]
RewriteCond %{HTTP_USER_AGENT} Bytespider [NC,OR]
RewriteCond %{HTTP_USER_AGENT} bytedance [NC,OR]
RewriteCond %{HTTP_USER_AGENT} geohasher [NC,OR]
RewriteCond %{HTTP_USER_AGENT} HTTrack [NC,OR]
RewriteCond %{HTTP_USER_AGENT} PycURL [NC,OR]
RewriteCond %{HTTP_USER_AGENT} Python-urllib [NC,OR]
RewriteCond %{HTTP_USER_AGENT} research-scan-bot [NC,OR]
RewriteCond %{HTTP_USER_AGENT} Sosospider [NC,OR]
RewriteCond %{HTTP_USER_AGENT} xenu [NC,OR]
RewriteCond %{HTTP_USER_AGENT} ^.*casper [NC,OR]
RewriteCond %{HTTP_USER_AGENT} ^.*goblox [NC,OR]
RewriteCond %{HTTP_USER_AGENT} ^.*sun4u [NC,OR]
RewriteCond %{HTTP_USER_AGENT} GPTBot [NC]
RewriteRule ^(.*)$ - [F]

# MediaWiki rewrites
RewriteRule ^wiki/(.*)$ /w/index.php?title=$1 [L,QSA]
RewriteRule ^wiki/*$ /w/index.php [L]
RewriteRule ^/*$ /w/index.php [L]

# Compression for better page speed
AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/ld+json image/svg+xml

# Cache control for static assets (if not handled by caching.conf)
<IfModule mod_headers.c>
    <FilesMatch "\.(ico|jpg|jpeg|png|gif|webp|svg)$">
        Header set Cache-Control "max-age=2592000, public"
    </FilesMatch>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "max-age=31536000, public"
    </FilesMatch>
</IfModule>

#AuthType Basic
#AuthName "Tower of Babel"
#AuthUserFile /home/doomwiki/passwd

