# Ignore files and directories generated by Composer
/vendor/
/web/core/
/web/modules/contrib/
/web/themes/contrib/
/web/profiles/contrib/
/web/libraries
.gitignore
!/.gitignore
/.editorconfig
/.gitattributes
/web/sites/default/default.*
/config/default/.htaccess

# Ignore sensitive information
/web/sites/*/settings.local.php

# Ignore paths that contain user-generated content, but ensure the related
# directories exist
/web/sites/*/files/*
!web/sites/*/files/.gitkeep
/private/*
!/private/.gitkeep


# Ignore multi-site test environment.
/sites/simpletest

# Ignore node files
node_modules/

# Ignore files compiled by gulp

