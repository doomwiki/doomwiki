# Ensure .editorconfig is always included
/!.editorconfig

# Ignore files generated by PhpStorm
.idea/

# Ignore VSCode, but allow debugging setup to be committed
.vscode/*
!.vscode/launch.json
*.code-workspace
.favorites.json

# Ignore .env files
.env
.settings.inc
.cron

# Ignore docker overrides.
docker-compose.override.yml

# Ignore user Composer auth token
.docker/composer/auth.json

# Ignore custom ssh config
.docker/ssh/config

# Ignore uploaded private files
.DS_Store
.bak

# Ignore tar/gz files
*.tar
*.gzx
